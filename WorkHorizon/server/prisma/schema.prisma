generator client {
  provider = "prisma-client-js" // กำหนดตัวเจนเนอเรต Client สำหรับใช้ใน Node.js
}

datasource db {
  provider = "mysql" // กำหนดประเภทฐานข้อมูลเป็น MySQL
  url      = env("DATABASE_URL") // ดึงค่าการเชื่อมต่อฐานข้อมูลจากไฟล์ .env
}

// ==========================================
// --- Enums (ตัวเลือกที่กำหนดค่าไว้ล่วงหน้า) ---
// ==========================================

enum Role {
  JOB_SEEKER // บทบาทผู้หางาน
  EMPLOYER // บทบาทผู้ว่าจ้าง/บริษัท
  SUPER_ADMIN // บทบาทผู้ดูแลระบบสูงสุด
  FREELANCER // บทบาทฟรีแลนซ์
}

enum AccountStatus {
  ACTIVE // บัญชีปกติใช้งานได้
  SUSPENDED // บัญชีถูกระงับชั่วคราว
  BANNED // บัญชีถูกแบนถาวร
}

enum ApplicationStatus {
  PENDING // ใบสมัครรอดำเนินการ
  REVIEWED // ผู้ว่าจ้างเปิดอ่านใบสมัครแล้ว
  SHORTLISTED // ผ่านการคัดเลือกเบื้องต้น
  REJECTED // ปฏิเสธการรับเข้าทำงาน
  HIRED // รับเข้าทำงาน/ตกลงจ้าง
  COMPLETED // งานเสร็จสิ้นตามกระบวนการ
}

enum JobStatus {
  DRAFT // งานที่ยังเป็นแบบร่าง (ยังไม่ประกาศ)
  PUBLISHED // งานที่ประกาศให้คนทั่วไปเห็นแล้ว
  ARCHIVED // งานที่ปิดรับสมัครและเก็บเข้ากรุ
  FILLED // งานที่ได้คนครบตามจำนวนที่ต้องการแล้ว
}

enum AdSize {
  LARGE_SLIDE // โฆษณาขนาดใหญ่แบบสไลด์ (900x300)
  SMALL_BANNER // โฆษณาขนาดเล็กด้านข้าง (300x250)
}

enum PaymentStatus {
  PENDING // การชำระเงินรอดำเนินการ
  SUCCESS // ชำระเงินสำเร็จ
  FAILED // ชำระเงินล้มเหลว
}

enum PaymentMethod {
  CREDIT_CARD // ชำระผ่านบัตรเครดิต
  BANK_TRANSFER // ชำระผ่านการโอนเงินธนาคาร
  WALLET // ชำระผ่านกระเป๋าเงินอิเล็กทรอนิกส์ในระบบ
}

enum TransactionType {
  TOPUP // ประเภทการเติมเงินเข้า Wallet
  PAYMENT // ประเภทการจ่ายค่าจ้าง
  WITHDRAWAL // ประเภทการถอนเงินออกจากระบบ
}

enum FreelancerWorkStatus {
  OFFER_PENDING // ข้อเสนอราคารอดำเนินการ
  IN_PROGRESS // งานกำลังดำเนินการ
  SUBMITTED // ฟรีแลนซ์ส่งงานแล้ว
  REVISION_REQUESTED // ผู้จ้างขอให้แก้ไขงาน
  COMPLETED // งานฟรีแลนซ์เสร็จสิ้นสมบูรณ์
  DISPUTED // งานมีข้อพิพาท/แจ้งปัญหา
  CANCELLED // ยกเลิกงาน
  REFUNDED // คืนเงินให้ผู้จ้างแล้ว
}

enum DisputeStatus {
  OPEN // เปิดข้อพิพาทใหม่
  IN_PROGRESS // เจ้าหน้าที่กำลังตรวจสอบปัญหา
  RESOLVED_COMPLETED // ตัดสินให้งานเสร็จ (จ่ายเงินให้ฟรีแลนซ์)
  RESOLVED_REFUNDED // ตัดสินให้ผู้จ้างชนะ (คืนเงินให้ผู้จ้าง)
  CLOSED // ปิดเคสข้อพิพาท
}

// ==========================================
// --- 1. Core Models (ตารางหลักของระบบ) ---
// ==========================================

model User {
  id              String        @id @default(cuid()) // รหัสผู้ใช้ (Primary Key)
  email           String        @unique // อีเมลผู้ใช้ (ต้องไม่ซ้ำ)
  password        String // รหัสผ่านที่เข้ารหัสแล้ว
  role            Role          @default(JOB_SEEKER) // บทบาทผู้ใช้ (ค่าเริ่มต้นคือผู้หางาน)
  firstName       String // ชื่อจริง
  lastName        String // นามสกุล
  phone           String // เบอร์โทรศัพท์
  createdAt       DateTime      @default(now()) // วันที่ลงทะเบียน
  walletBalance   Decimal       @default(0.00) // ยอดเงินในกระเป๋า (ทศนิยม 2 ตำแหน่ง)
  status          AccountStatus @default(ACTIVE) // สถานะบัญชี
  profileImageUrl String? // ลิงก์รูปโปรไฟล์ (มีหรือไม่มีก็ได้)
  bio             String?       @db.Text // ข้อมูลแนะนำตัวแบบยาว

  // Relations (ความสัมพันธ์กับตารางอื่น)
  company              Company? // เชื่อมกับข้อมูลบริษัท (1-to-1)
  applications         Application[] // เชื่อมกับประวัติการสมัครงาน
  freelancerProfile    FreelancerProfile? // เชื่อมกับโปรไฟล์ฟรีแลนซ์
  services             Service[] // เชื่อมกับบริการที่ลงขาย
  transactions         Transaction[] // เชื่อมกับประวัติธุรกรรมที่จ่าย
  transactionsReceived Transaction[]      @relation("TransactionReceiver") // เชื่อมกับธุรกรรมที่ได้รับเงิน
  educations           Education[] // เชื่อมกับประวัติการศึกษา
  experiences          Experience[] // เชื่อมกับประสบการณ์ทำงาน
  resumes              Resume[] // เชื่อมกับไฟล์เรซูเม่
  skills               Skill[]            @relation("UserSkills") // เชื่อมกับทักษะ (Many-to-Many)
  savedJobs            SavedJob[] // เชื่อมกับงานที่กดบันทึกไว้
  messages             Message[] // เชื่อมกับข้อความแชท
  notifications        Notification[] // เชื่อมกับระบบแจ้งเตือน
  applicantRatings     ApplicantRating[] // เชื่อมกับการให้คะแนนผู้สมัคร
  internalNotes        InternalNote[] // เชื่อมกับบันทึกภายในของผู้จัดการ
  customerServices     ServiceConversation[] @relation("CustomerService") // แชทในฐานะลูกค้า
  freelancerServices   ServiceConversation[] @relation("FreelancerService") // แชทในฐานะฟรีแลนซ์

  // Freelancer & Dispute Relations
  freelancerWorksCompleted  FreelancerWork[]   @relation("FreelancerCompleted") // งานที่ทำเสร็จ
  freelancerWorksHired      FreelancerWork[]   @relation("JobSeekerHired") // งานที่จ้างคนอื่นทำ
  freelancerReviewsGiven    FreelancerReview[] @relation("ReviewGiver") // รีวิวที่ส่งให้คนอื่น
  freelancerReviewsReceived FreelancerReview[] @relation("ReviewReceiver") // รีวิวที่ได้รับจากคนอื่น
  createdTickets            DisputeTicket[]    @relation("TicketCreator") // ข้อพิพาทที่ตนเองแจ้ง
  disputeMessages           DisputeMessage[] // ข้อความในระบบข้อพิพาท
}

model Company {
  id          String  @id @default(cuid()) // รหัสบริษัท
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade) // เจ้าของบริษัท (ลบ User ลบบริษัทด้วย)
  userId      String  @unique // รหัสผู้ใช้อ้างอิง
  companyName String // ชื่อบริษัท
  description String  @db.Text // รายละเอียดบริษัท
  website     String? // เว็บไซต์บริษัท
  address     String? // ที่อยู่บริษัท
  logoUrl     String? // ลิงก์โลโก้บริษัท
  companySize String? // ขนาดองค์กร
  isVerified  Boolean @default(false) // สถานะการยืนยันตัวตนจาก Admin

  jobs       Job[] // รายการงานที่บริษัทประกาศ
  industry   Industry? @relation(fields: [industryId], references: [id]) // อุตสาหกรรมที่เกี่ยวข้อง
  industryId String? // รหัสอุตสาหกรรมอ้างอิง
}

model FreelancerProfile {
  id                String   @id @default(cuid()) // รหัสโปรไฟล์ฟรีแลนซ์
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade) // เชื่อมกับผู้ใช้
  userId            String   @unique // รหัสผู้ใช้อ้างอิง
  professionalTitle String? // หัวข้ออาชีพ (เช่น Full-stack Developer)
  bio               String?  @db.Text // ประวัติผลงาน/แนะนำตัว
  hourlyRate        Decimal? // เรทราคาต่อชั่วโมง
  portfolioUrl      String? // ลิงก์พอร์ตโฟลิโอภายนอก
  yearsOfExperience Int? // จำนวนปีที่ทำงานมา
  isVerified        Boolean  @default(false) // สถานะฟรีแลนซ์ยืนยันตัวตน
  profileImageUrl   String? // รูปโปรไฟล์เสริมสำหรับงานฟรีแลนซ์
  createdAt         DateTime @default(now()) // วันที่เปิดโปรไฟล์
  updatedAt         DateTime @updatedAt // วันที่แก้ไขข้อมูลล่าสุด

  completedWorks FreelancerWork[]   @relation("FreelancerProfile") // ประวัติงานที่ทำเสร็จ
  reviews        FreelancerReview[] @relation("FreelancerProfileReviews") // รีวิวที่ได้รับในโปรไฟล์นี้
}

model Service {
  id             String        @id @default(uuid()) // รหัสบริการ (UUID)
  title          String // ชื่อบริการที่ลงขาย
  description    String        @db.Text // รายละเอียดของบริการ
  price          Decimal // ราคาของบริการ
  coverImage     String? // รูปปกของบริการ
  category       String? // หมวดหมู่บริการ
  isActive       Boolean       @default(true) // สถานะเปิด/ปิดการขายบริการ
  createdAt      DateTime      @default(now()) // วันที่สร้างบริการ
  updatedAt      DateTime      @updatedAt // วันที่แก้ไขบริการล่าสุด
  mainCategoryId String? // รหัสหมวดหมู่หลัก
  mainCategory   MainCategory? @relation(fields: [mainCategoryId], references: [id]) // เชื่อมหมวดหมู่หลัก
  freelancerId   String // รหัสฟรีแลนซ์ผู้ขาย
  freelancer     User          @relation(fields: [freelancerId], references: [id], onDelete: Cascade) // เชื่อมกับผู้ขาย

  serviceConversations ServiceConversation[] // การแชทที่สอบถามเกี่ยวกับบริการนี้
}

model Job {
  id                 String    @id @default(cuid()) // รหัสงาน
  title              String // ชื่อตำแหน่งงาน
  description        String    @db.Text // รายละเอียดงาน
  responsibilities   String?   @db.Text // หน้าที่ความรับผิดชอบ
  benefits           String?   @db.Text // สวัสดิการ
  workingHours       String?   @db.Text // เวลาทำงาน
  location           String? // สถานที่ทำงาน (กรณี On-site)
  salaryMin          Decimal? // เงินเดือนเริ่มต้น
  salaryMax          Decimal? // เงินเดือนสูงสุด
  createdAt          DateTime  @default(now()) // วันที่โพสต์งาน
  status             JobStatus @default(DRAFT) // สถานะของโพสต์งาน
  expiresAt          DateTime? // วันที่ปิดรับสมัคร
  isSalaryNegotiable Boolean   @default(false) // สถานะการต่อรองเงินเดือนได้

  companyId      String // รหัสบริษัทที่ประกาศ
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade) // เชื่อมกับบริษัท
  subCategoryId  String? // รหัสหมวดหมู่ย่อย
  subCategory    SubCategory? @relation(fields: [subCategoryId], references: [id]) // เชื่อมหมวดหมู่ย่อย
  mainCategoryId String // รหัสหมวดหมู่หลัก
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id]) // เชื่อมหมวดหมู่หลัก
  jobTypeId      String // รหัสประเภทงาน (Full-time/Part-time)
  jobType        JobType      @relation(fields: [jobTypeId], references: [id]) // เชื่อมประเภทงาน
  provinceId     String // รหัสจังหวัด
  province       Province     @relation(fields: [provinceId], references: [id]) // เชื่อมจังหวัด
  districtId     String // รหัสอำเภอ
  district       District     @relation(fields: [districtId], references: [id]) // เชื่อมอำเภอ

  requiredSkills Skill[]       @relation("JobSkills") // ทักษะที่ต้องการ (Many-to-Many)
  applications   Application[] // รายการคนสมัครงานนี้
  savedBy        SavedJob[] // รายการคนที่บันทึกงานนี้ไว้
  images         JobImage[] // รูปภาพประกอบงาน
  documents      JobDocument[] // เอกสารประกอบงาน (PDF)

  @@index([subCategoryId])
  @@index([mainCategoryId])
}

// ==========================================
// --- 2. Support Models (ตารางเสริมอื่นๆ) ---
// ==========================================

model JobDocument {
  id        String   @id @default(cuid()) // รหัสเอกสาร
  name      String // ชื่อไฟล์
  url       String // ลิงก์ที่เก็บไฟล์
  createdAt DateTime @default(now()) // วันที่อัปโหลด
  jobId     String // รหัสงานอ้างอิง
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade) // เชื่อมกับงาน
}

model JobImage {
  id        String   @id @default(cuid()) // รหัสรูปภาพ
  url       String // ลิงก์รูปภาพ
  createdAt DateTime @default(now()) // วันที่อัปโหลด
  jobId     String // รหัสงานอ้างอิง
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade) // เชื่อมกับงาน

  @@index([jobId])
}

model Application {
  id          String            @id @default(cuid()) // รหัสการสมัครงาน
  status      ApplicationStatus @default(PENDING) // สถานะใบสมัคร
  appliedAt   DateTime          @default(now()) // วันที่ส่งใบสมัคร
  coverLetter String?           @db.Text // จดหมายแนะนำตัว
  resumeId    String? // รหัสเรซูเม่อ้างอิง
  resume      Resume?           @relation(fields: [resumeId], references: [id]) // เรซูเม่ที่ใช้สมัคร
  jobId       String // รหัสงานที่สมัคร
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade) // เชื่อมกับงาน
  userId      String // รหัสผู้สมัคร
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade) // เชื่อมกับผู้สมัคร

  conversation  Conversation? // ห้องแชทระหว่างผู้สมัครกับนายจ้าง
  ratings       ApplicantRating[] // การประเมินคะแนนผู้สมัคร
  internalNotes InternalNote[] // บันทึกช่วยจำสำหรับนายจ้าง

  @@unique([jobId, userId]) // 1 คนสมัครงานเดิมซ้ำไม่ได้
}

model Education {
  id           String    @id @default(cuid()) // รหัสประวัติการศึกษา
  userId       String // รหัสผู้ใช้อ้างอิง
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade) // เชื่อมกับผู้ใช้
  institute    String // ชื่อสถาบันการศึกษา
  degree       String // วุฒิการศึกษา
  fieldOfStudy String // คณะ/สาขาวิชา
  startDate    DateTime // วันที่เริ่มเรียน
  endDate      DateTime? // วันที่จบการศึกษา
}

model Experience {
  id          String    @id @default(cuid()) // รหัสประวัติการทำงาน
  userId      String // รหัสผู้ใช้อ้างอิง
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade) // เชื่อมกับผู้ใช้
  title       String // ตำแหน่งงาน
  company     String // ชื่อบริษัท
  description String?   @db.Text // รายละเอียดหน้าที่
  startDate   DateTime // วันที่เริ่มงาน
  endDate     DateTime? // วันที่ลาออก
}

model Resume {
  id         String   @id @default(cuid()) // รหัสเรซูเม่
  userId     String // รหัสผู้ใช้อ้างอิง
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade) // เชื่อมกับผู้ใช้
  filename   String // ชื่อไฟล์เรซูเม่
  url        String // ลิงก์ที่เก็บไฟล์
  uploadedAt DateTime @default(now()) // วันที่อัปโหลด

  applications Application[] // การสมัครงานที่ใช้เรซูเม่ใบนี้
}

// ==========================================
// --- 3. Master Data (ตารางข้อมูลพื้นฐานระบบ) ---
// ==========================================

model MainCategory {
  id        String   @id @default(cuid()) // รหัสหมวดหมู่หลัก
  name      String   @unique // ชื่อหมวดหมู่ (เช่น ไอที)
  imageUrl  String? // รูปไอคอนหมวดหมู่
  createAt  DateTime @default(now()) // วันที่สร้าง
  updateAt  DateTime @updatedAt // วันที่อัปเดต

  subCategorys     SubCategory[] // หมวดหมู่ย่อยในสังกัด
  jobs             Job[] // งานในหมวดหมู่หลักนี้
  featuredSections FeaturedSection[] // ส่วนแสดงเนื้อหาแนะนำ
  services         Service[] // บริการฟรีแลนซ์ในหมวดหมู่นี้
}

model SubCategory {
  id             String       @id @default(cuid()) // รหัสหมวดหมู่ย่อย
  name           String // ชื่อหมวดหมู่ย่อย (เช่น React Developer)
  iconCode       String? // รหัสไอคอน
  createdAt      DateTime     @default(now()) // วันที่สร้าง
  updatedAt      DateTime     @updatedAt // วันที่อัปเดต
  mainCategoryId String // รหัสหมวดหมู่หลักอ้างอิง
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade) // เชื่อมหมวดหมู่หลัก
  jobs           Job[] // งานในหมวดหมู่ย่อยนี้

  @@unique([name, mainCategoryId]) // ชื่อย่อยต้องไม่ซ้ำในหมวดหลักเดียวกัน
  @@index([mainCategoryId])
}

model JobType {
  id   String @id @default(cuid()) // รหัสประเภทงาน
  name String @unique // ชื่อประเภท (เช่น งานประจำ, สัญญาจ้าง)
  jobs Job[] // งานที่เป็นประเภทนี้
}

model Province {
  id        String     @id @default(cuid()) // รหัสจังหวัด
  name      String     @unique // ชื่อจังหวัด
  jobs      Job[] // งานที่อยู่ในจังหวัดนี้
  districts District[] // รายการอำเภอในจังหวัดนี้
}

model District {
  id         String   @id @default(cuid()) // รหัสอำเภอ
  name       String // ชื่ออำเภอ
  provinceId String // รหัสจังหวัดอ้างอิง
  province   Province @relation(fields: [provinceId], references: [id]) // เชื่อมกับจังหวัด
  jobs       Job[] // งานที่อยู่ในอำเภอนี้

  @@unique([name, provinceId]) // ชื่ออำเภอต้องไม่ซ้ำในจังหวัดเดียวกัน
}

model Skill {
  id    String @id @default(cuid()) // รหัสทักษะ
  name  String @unique // ชื่อทักษะ (เช่น JavaScript, Photoshop)
  users User[] @relation("UserSkills") // ผู้ใช้ที่มีทักษะนี้
  jobs  Job[]  @relation("JobSkills") // งานที่ต้องการทักษะนี้
}

model Industry {
  id        String    @id @default(cuid()) // รหัสอุตสาหกรรม
  name      String    @unique // ชื่ออุตสาหกรรม (เช่น การผลิต, การเงิน)
  companies Company[] // บริษัทที่อยู่ในกลุ่มอุตสาหกรรมนี้
}

// ==========================================
// --- 4. Feature Models (ระบบการทำงานเสริม) ---
// ==========================================

model SavedJob {
  id      String   @id @default(cuid()) // รหัสการบันทึกงาน
  userId  String // รหัสผู้ใช้
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade) // เชื่อมกับผู้ใช้
  jobId   String // รหัสงาน
  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade) // เชื่อมกับงาน
  savedAt DateTime @default(now()) // วันที่กดบันทึก

  @@unique([userId, jobId]) // 1 คนบันทึกงานเดิมได้ครั้งเดียว
}

model Conversation {
  id            String      @id @default(cuid()) // รหัสห้องสนทนา
  applicationId String      @unique // รหัสการสมัครงานที่สร้างแชทนี้
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade) // เชื่อมกับใบสมัคร
  messages      Message[] // ข้อความในแชทนี้
  createdAt     DateTime    @default(now()) // วันที่สร้างห้องแชท
  updatedAt     DateTime    @updatedAt // วันที่แก้ไขล่าสุด
}

model ServiceConversation {
  id        String   @id @default(uuid()) // รหัสการแชทในบริการฟรีแลนซ์
  serviceId String // รหัสบริการที่คุย
  service   Service  @relation(fields: [serviceId], references: [id]) // เชื่อมกับบริการ
  user1Id   String // รหัสผู้ซื้อ
  user1     User     @relation("CustomerService", fields: [user1Id], references: [id]) // เชื่อมกับผู้ซื้อ
  user2Id   String // รหัสผู้ขาย
  user2     User     @relation("FreelancerService", fields: [user2Id], references: [id]) // เชื่อมกับผู้ขาย
  messages  Message[] // รายการข้อความแชท
  createdAt DateTime @default(now()) // วันที่เริ่มแชท
  updatedAt DateTime @updatedAt // วันที่แก้ไขล่าสุด

  @@unique([serviceId, user1Id]) // 1 บริการ 1 คู่คนซื้อคนขายมีห้องเดียวพอ
}

model Message {
  id                    String               @id @default(cuid()) // รหัสข้อความ
  content               String               @db.Text // เนื้อหาข้อความ
  createdAt             DateTime             @default(now()) // เวลาที่ส่ง
  conversationId        String? // รหัสแชทสมัครงาน (ถ้ามี)
  conversation          Conversation?        @relation(fields: [conversationId], references: [id], onDelete: Cascade) // เชื่อมแชทสมัครงาน
  serviceConversationId String? // รหัสแชทบริการฟรีแลนซ์ (ถ้ามี)
  serviceConversation   ServiceConversation? @relation(fields: [serviceConversationId], references: [id]) // เชื่อมแชทฟรีแลนซ์
  senderId              String // รหัสผู้ส่ง
  sender                User                 @relation(fields: [senderId], references: [id], onDelete: Cascade) // เชื่อมกับผู้ส่ง
}

model Notification {
  id        String   @id @default(cuid()) // รหัสแจ้งเตือน
  userId    String // รหัสผู้รับ
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade) // เชื่อมผู้รับ
  content   String // ข้อความแจ้งเตือน
  link      String? // ลิงก์สำหรับกดไปดูรายละเอียด
  isRead    Boolean  @default(false) // สถานะการอ่าน
  createdAt DateTime @default(now()) // วันที่แจ้งเตือน
}

model Advertisement {
  id        String   @id @default(cuid()) // รหัสโฆษณา
  title     String // ชื่อโฆษณา
  imageUrl  String // ลิงก์รูปโฆษณา
  linkUrl   String? // ลิงก์เมื่อกดโฆษณา
  isActive  Boolean  @default(true) // สถานะเปิด/ปิดโฆษณา
  adSize    AdSize   @default(LARGE_SLIDE) // ขนาดของป้ายโฆษณา
  createdAt DateTime @default(now()) // วันที่สร้างโฆษณา
}

model FeaturedSection {
  id             String       @id @default(cuid()) // รหัสส่วนแนะนำ
  title          String // ชื่อหัวข้อแนะนำ (เช่น งานยอดนิยม)
  sortOrder      Int          @default(0) // ลำดับการแสดงผล
  mainCategoryId String // หมวดหมู่หลักที่เกี่ยวข้อง
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id]) // เชื่อมหมวดหมู่หลัก
  createdAt      DateTime     @default(now()) // วันที่สร้าง
  contentType    String       @default("JOB") // ประเภทเนื้อหา (JOB/SERVICE)

  @@index([mainCategoryId])
}

model ApplicantRating {
  id            String      @id @default(cuid()) // รหัสการประเมิน
  rating        Int // คะแนน (1-5)
  comment       String?     @db.Text // ความคิดเห็นเพิ่มเติม
  raterId       String // รหัสผู้ให้คะแนน
  rater         User        @relation(fields: [raterId], references: [id], onDelete: Cascade) // เชื่อมผู้ให้คะแนน
  applicationId String // รหัสใบสมัครอ้างอิง
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade) // เชื่อมใบสมัคร

  @@unique([raterId, applicationId]) // 1 คนประเมินใบสมัครเดิมได้ครั้งเดียว
}

model InternalNote {
  id            String      @id @default(cuid()) // รหัสบันทึกภายใน
  content       String      @db.Text // เนื้อหาบันทึก
  authorId      String // รหัสผู้เขียนบันทึก
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade) // เชื่อมผู้เขียน
  applicationId String // รหัสใบสมัครอ้างอิง
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade) // เชื่อมใบสมัคร
  createdAt     DateTime    @default(now()) // วันที่บันทึก
}

// ==========================================
// --- 5. Freelancer & Payment Systems (ระบบงานฟรีแลนซ์และการเงิน) ---
// ==========================================

model FreelancerWork {
  id                  String               @id @default(cuid()) // รหัสใบงานฟรีแลนซ์
  jobSeekerId         String // รหัสผู้จ้าง
  jobSeeker           User                 @relation("JobSeekerHired", fields: [jobSeekerId], references: [id], onDelete: Cascade) // เชื่อมผู้จ้าง
  freelancerId        String // รหัสผู้รับจ้าง
  freelancer          User                 @relation("FreelancerCompleted", fields: [freelancerId], references: [id], onDelete: Cascade) // เชื่อมผู้รับจ้าง
  freelancerProfileId String // รหัสโปรไฟล์ฟรีแลนซ์อ้างอิง
  freelancerProfile   FreelancerProfile    @relation("FreelancerProfile", fields: [freelancerProfileId], references: [id], onDelete: Cascade) // เชื่อมโปรไฟล์ฟรีแลนซ์
  jobTitle            String // หัวชื่องานที่จ้าง
  description         String?              @db.Text // รายละเอียดงานที่ตกลงกัน
  status              FreelancerWorkStatus @default(OFFER_PENDING) // สถานะความคืบหน้างาน
  completedAt         DateTime? // วันที่งานเสร็จสมบูรณ์
  price               Decimal? // ราคาที่ตกลงจ้าง
  duration            Int? // ระยะเวลาทำงาน (วัน)
  revisionCount       Int                  @default(0) // จำนวนครั้งที่แก้ไขงาน
  createdAt           DateTime             @default(now()) // วันที่เริ่มจ้างงาน
  updatedAt           DateTime             @updatedAt // วันที่อัปเดตสถานะล่าสุด

  review        FreelancerReview? // รีวิวหลังจากจบงาน (1-to-1)
  transactions  Transaction[] // รายการธุรกรรมเงินมัดจำ/ค่าจ้าง
  disputeTicket DisputeTicket? // ตั๋วข้อพิพาทถ้างานมีปัญหา (1-to-1)

  @@index([freelancerId])
  @@index([jobSeekerId])
  @@index([freelancerProfileId])
}

model FreelancerReview {
  id                  String            @id @default(cuid()) // รหัสรีวิว
  rating              Int // คะแนนความพึงพอใจ
  comment             String?           @db.Text // คำชมหรือข้อเสนอแนะ
  workId              String            @unique // รหัสงานอ้างอิง
  work                FreelancerWork    @relation(fields: [workId], references: [id], onDelete: Cascade) // เชื่อมกับใบงาน
  reviewerId          String // รหัสผู้ให้รีวิว (ผู้จ้าง)
  reviewer            User              @relation("ReviewGiver", fields: [reviewerId], references: [id], onDelete: Cascade) // เชื่อมผู้ให้รีวิว
  reviewedId          String // รหัสผู้รับรีวิว (ฟรีแลนซ์)
  reviewed            User              @relation("ReviewReceiver", fields: [reviewedId], references: [id], onDelete: Cascade) // เชื่อมผู้รับรีวิว
  freelancerProfileId String // รหัสโปรไฟล์ฟรีแลนซ์
  freelancerProfile   FreelancerProfile @relation("FreelancerProfileReviews", fields: [freelancerProfileId], references: [id], onDelete: Cascade) // เชื่อมโปรไฟล์ฟรีแลนซ์
  createdAt           DateTime          @default(now()) // วันที่รีวิว

  @@index([reviewerId])
  @@index([reviewedId])
  @@index([freelancerProfileId])
}

model Transaction {
  id         String          @id @default(cuid()) // รหัสธุรกรรม
  amount     Decimal // จำนวนเงิน
  status     PaymentStatus   @default(PENDING) // สถานะธุรกรรม
  slipUrl    String? // ลิงก์รูปสลิปหลักฐาน
  gatewayRef String? // รหัสอ้างอิงจากระบบธนาคาร
  method     PaymentMethod // วิธีการชำระเงิน
  type       TransactionType @default(PAYMENT) // ประเภทธุรกรรม (เติม/จ่าย/ถอน)
  payerId    String // รหัสคนจ่าย
  payer      User            @relation(fields: [payerId], references: [id], onDelete: Cascade) // เชื่อมคนจ่าย
  workId     String? // รหัสใบงานฟรีแลนซ์ (ถ้ามี)
  work       FreelancerWork? @relation(fields: [workId], references: [id]) // เชื่อมใบงาน
  receiverId String? // รหัสคนรับเงิน
  receiver   User?           @relation("TransactionReceiver", fields: [receiverId], references: [id]) // เชื่อมคนรับเงิน
  createdAt  DateTime        @default(now()) // วันที่ทำรายการ
  updatedAt  DateTime        @updatedAt // วันที่อัปเดตสถานะรายการ
}

model DisputeTicket {
  id           String        @id @default(cuid()) // รหัสข้อพิพาท
  ticketNumber String        @unique // หมายเลขตั๋วข้อพิพาท (เช่น DIS-xxx)
  workId       String        @unique // รหัสใบงานที่มีปัญหา
  work         FreelancerWork @relation(fields: [workId], references: [id], onDelete: Cascade) // เชื่อมใบงานที่มีปัญหา
  creatorId    String // รหัสคนเปิดเคส
  creator      User          @relation("TicketCreator", fields: [creatorId], references: [id]) // เชื่อมผู้แจ้งปัญหา
  reason       String // เหตุผลการเปิดข้อพิพาท
  description  String        @db.Text // รายละเอียดปัญหาอย่างละเอียด
  status       DisputeStatus @default(OPEN) // สถานะการดำเนินการของเคส
  createdAt    DateTime      @default(now()) // วันที่แจ้งเรื่อง
  updatedAt    DateTime      @updatedAt // วันที่อัปเดตเรื่องล่าสุด

  messages DisputeMessage[] // ข้อความโต้ตอบภายในเคสนี้
}

model DisputeMessage {
  id        String        @id @default(cuid()) // รหัสข้อความโต้ตอบ
  content   String        @db.Text // เนื้อหาข้อความ
  fileUrl   String? // รูปภาพหลักฐานประกอบ
  ticketId  String // รหัสเคสอ้างอิง
  ticket    DisputeTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade) // เชื่อมกับตั๋วเคส
  senderId  String // รหัสคนส่ง (คู่กรณีหรือ Admin)
  sender    User          @relation(fields: [senderId], references: [id]) // เชื่อมคนส่ง
  createdAt DateTime      @default(now()) // เวลาที่ส่งข้อความ
}